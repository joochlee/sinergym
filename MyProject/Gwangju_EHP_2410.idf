    -0.012,                  !- Coefficient4 y
    0.00005,                 !- Coefficient5 y**2
    0.0,                     !- Coefficient6 x*y
    15.0,                    !- Minimum Value of x
    27.0,                    !- Maximum Value of x
    -20.0,                   !- Minimum Value of y
    15.0;                    !- Maximum Value of y

  Curve:Biquadratic,
    VRFDefrostEIRFT,         !- Name
    1.0,                     !- Coefficient1 Constant
    0.0,                     !- Coefficient2 x
    0.0,                     !- Coefficient3 x**2
    0.0,                     !- Coefficient4 y
    0.0,                     !- Coefficient5 y**2
    0.0,                     !- Coefficient6 x*y
    -20,                     !- Minimum Value of x
    15,                      !- Maximum Value of x
    -20,                     !- Minimum Value of y
    15;                      !- Maximum Value of y

