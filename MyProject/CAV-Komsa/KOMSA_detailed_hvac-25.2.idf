!-   ===========  FCU ZONE EQUIPMENT  ===========

  ZoneHVAC:EquipmentList,
    HVAC_M_1_E Equipment List,  !- Name
    SequentialLoad,          !- Load Distribution Scheme
    ZoneHVAC:FourPipeFanCoil,!- Zone Equipment 1 Object Type
    HVAC_M_1_E FCU,          !- Zone Equipment 1 Name
    1,                       !- Zone Equipment 1 Cooling Sequence
    1,                       !- Zone Equipment 1 Heating or No-Load Sequence
    ,                        !- Zone Equipment 1 Sequential Cooling Fraction Schedule Name
    ;                        !- Zone Equipment 1 Sequential Heating Fraction Schedule Name

  ZoneHVAC:EquipmentConnections,
    HVAC_M_1_E,              !- Zone Name
    HVAC_M_1_E Equipment List,  !- Zone Conditioning Equipment List Name
    HVAC_M_1_E Zone Air Inlet,  !- Zone Air Inlet Node or NodeList Name
    HVAC_M_1_E Zone Air Exhaust,  !- Zone Air Exhaust Node or NodeList Name
    HVAC_M_1_E Zone Air Node,!- Zone Air Node Name
    HVAC_M_1_E Zone Return Air;  !- Zone Return Air Node or NodeList Name

  OutdoorAir:Mixer,
    HVAC_M_1_E FCU OA Mixer, !- Name
    HVAC_M_1_E FCU Mixed Air,!- Mixed Air Node Name
    HVAC_M_1_E FCU OA Inlet, !- Outdoor Air Stream Node Name
    HVAC_M_1_E FCU Relief Air,  !- Relief Air Stream Node Name
    HVAC_M_1_E Zone Air Exhaust;  !- Return Air Stream Node Name

  OutdoorAir:NodeList,
    HVAC_M_1_E FCU OA Inlet; !- Node or NodeList Name 1

  Fan:SystemModel,
    HVAC_M_1_E FCU Fan,      !- Name
    Always On Discrete,      !- Availability Schedule Name
    HVAC_M_1_E FCU Mixed Air,!- Air Inlet Node Name
    HVAC_M_1_E FCU Fan Outlet,  !- Air Outlet Node Name
    autosize,                !- Design Maximum Air Flow Rate {m3/s}
    Discrete,                !- Speed Control Method
    0.0,                     !- Electric Power Minimum Flow Rate Fraction
    75,                      !- Design Pressure Rise {Pa}
    0.9,                     !- Motor Efficiency
    1.0,                     !- Motor In Air Stream Fraction
    autosize,                !- Design Electric Power Consumption {W}
    ,                        !- Design Power Sizing Method
    ,                        !- Electric Power Per Unit Flow Rate {W/(m3/s)}
    ,                        !- Electric Power Per Unit Flow Rate Per Unit Pressure {W/((m3/s)-Pa)}
    0.7;                     !- Fan Total Efficiency

  Coil:Cooling:Water,
    HVAC_M_1_E FCU CC,       !- Name
    Always On Discrete,      !- Availability Schedule Name
    autosize,                !- Design Water Flow Rate {m3/s}
    autosize,                !- Design Air Flow Rate {m3/s}
